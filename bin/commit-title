#!/usr/bin/env bash
#
# Checks that each argument is a Conventional Commits title, `type(scope): summary` or
# `type: summary` (with `!` before the colon for a breaking change), so release-please can put
# it in the changelog. The types are the changelog sections in release-please-config.json.
# Used by the Conventional Commits workflow, for pull request titles and commits.
#
#   bin/commit-title "feat(theme): add the team block" ...

set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)

types=$(grep -o '"type": *"[a-z]*"' "$root/release-please-config.json" | sed 's/.*"\([a-z]*\)"$/\1/' | paste -sd '|' -)
pattern="^($types)(\([^()]+\))?!?: [^ ]"

status=0
for title in "$@"; do
    if [[ ! $title =~ $pattern ]]; then
        echo "Not a Conventional Commits title: $title" >&2
        status=1
    fi
done

if [[ $status -ne 0 ]]; then
    echo "Write it as type(scope): summary or type: summary, with one of these types: ${types//|/, }." >&2
    echo "See https://www.conventionalcommits.org/." >&2
fi
exit $status
